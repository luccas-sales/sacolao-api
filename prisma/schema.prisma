generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model suppliers {
  id                Int     @id @default(autoincrement())
  tax_id            String  @unique(map: "uq_suppliers_tax_id") @db.VarChar(14)
  legal_name        String  @db.VarChar
  legal_nature      String? @db.VarChar
  legal_description String? @db.VarChar
  sector            String  @db.VarChar
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notes_rural_suppliers {
  id                 Int       @id @default(autoincrement())
  supplier_tax_id    String    @db.VarChar
  supplier_name      String?   @db.VarChar
  sector             String?   @db.VarChar
  note               String?   @db.VarChar
  note_access_key    String?   @db.VarChar(44)
  note_date          DateTime? @db.Timestamptz(6)
  issuer_tax_id      String?   @db.VarChar
  receipt            String?   @db.VarChar
  receipt_access_key String?   @unique @db.VarChar(44)
  receipt_date       DateTime? @db.Timestamptz(6)
  value              String?   @db.VarChar
  status             String?   @default("000") @db.VarChar
  is_duplicate       Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  goods_received     Boolean?  @default(false)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model daily_sales {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cash_register_id  String         @db.Uuid
  report_date       DateTime       @db.Date
  total_nfce        Decimal        @default(0) @db.Decimal(12, 2)
  total_nfe         Decimal        @default(0) @db.Decimal(12, 2)
  total_summary_map Decimal        @default(0) @db.Decimal(12, 2)
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  cash_registers    cash_registers @relation(fields: [cash_register_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cash_register_id, report_date])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stores {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  tax_id               String?
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  number               Int?
  cash_registers       cash_registers[]
  product_monthly_data product_monthly_data[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String    @unique
  password_hash String
  created_at    DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  permissions   Json      @default("[]")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cash_registers {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id    String        @db.Uuid
  number      Int
  nfce_series Int
  nfe_series  Int
  description String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  stores      stores        @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  daily_sales daily_sales[]

  @@unique([store_id, nfce_series])
  @@unique([store_id, nfe_series])
  @@unique([store_id, number])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_monthly_data {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id              String    @db.Uuid
  store_id                String    @db.Uuid
  reference_month         DateTime  @db.Date
  obs                     String?
  is_new                  Boolean?  @default(false)
  correct_icms_office     String?
  was_st                  Boolean?  @default(false)
  made_in_store           Boolean?  @default(false)
  monitored               String?
  department              String?
  section                 String?
  category_group          String?
  icms_mix_fiscal         String?
  barcode                 String?
  plucode                 String?
  description             String?
  billing                 String?
  icms                    String?
  icms_aliquot            String?
  icms_aliquot_last_sale  String?
  icms_aliquot_mix_fiscal String?
  cest                    String?
  cest_mix_fiscal         String?
  cest_last_sale          String?
  cbenef                  String?
  cbenef_mix_fiscal       String?
  cbenef_last_sale        String?
  ncm                     String?
  ncm_mix_fiscal          String?
  ncm_last_sale           String?
  pis_cofins              Boolean?  @default(false)
  pis_cofins_mix_fiscal   Boolean?  @default(false)
  pis_cofins_last_sale    Boolean?  @default(false)
  c_class                 String?
  c_class_mix_fiscal      String?
  c_class_last_sale       String?
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)
  note_number_last_sale   String?
  access_key_last_sale    String?
  supplier_last_sale      String?
  date_last_sale          String?
  products                products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores                  stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, store_id, reference_month], map: "unique_product_store_month")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  product_monthly_data product_monthly_data[]
}
